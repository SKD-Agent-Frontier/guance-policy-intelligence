{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "政策语料切块流程 · 方案 v1.0.2",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "animation": "none",
    "legend": {
      "entries": {
        "backend": { "label": "程序模块" },
        "database": { "label": "原文与结果" },
        "cloud": { "label": "模型复核" },
        "security": { "label": "人工裁决" }
      }
    }
  },
  "lanes": [
    { "id": "program", "label": "程序处理" },
    { "id": "model", "label": "大模型复核" },
    { "id": "human", "label": "人工裁决", "variant": "exception" }
  ],
  "phases": [
    { "id": "source-phase", "label": "输入", "fromCol": 0, "toCol": 0 },
    { "id": "structure-phase", "label": "第一阶段：确定原文结构", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "chunk-phase", "label": "第二阶段：确定父子块", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "search-phase", "label": "后续接入", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["source", "parse", "structure-review", "structure-ready", "build", "chunk-review", "output", "retrieval"],
  "semanticChecks": {
    "allowedRoots": ["source"],
    "allowedTerminals": ["retrieval"],
    "requiredPaths": [
      { "from": "parse", "to": "structure-review" },
      { "from": "structure-review", "to": "structure-ready" },
      { "from": "structure-human", "to": "structure-ready" },
      { "from": "structure-ready", "to": "build" },
      { "from": "build", "to": "chunk-review" },
      { "from": "chunk-human", "to": "output" }
    ]
  },
  "nodes": [
    { "id": "source", "lane": "program", "col": 0, "type": "database", "label": "读取原文", "sublabel": "哈希 · 原文定位", "tag": "标准引用库", "width": 140 },
    { "id": "parse", "lane": "program", "col": 1, "type": "backend", "label": "识别单元与层级", "sublabel": "语法 · 编号 · 上下文", "tag": "保存结构初始版", "width": 156 },
    { "id": "structure-review", "lane": "model", "col": 1, "type": "cloud", "label": "复核原文结构", "sublabel": "边界 · 类型 · 归属", "tag": "记录模型意见", "width": 156 },
    { "id": "structure-human", "lane": "human", "col": 1, "type": "security", "label": "裁决结构争议", "sublabel": "对照原文判断", "tag": "未解决则待处理", "width": 156 },
    { "id": "structure-ready", "lane": "program", "col": 2, "type": "database", "label": "校验并确定结构", "sublabel": "覆盖 · 层级有效", "tag": "传递结构版本", "width": 148 },
    { "id": "build", "lane": "program", "col": 3, "type": "backend", "label": "划分父块与子块", "sublabel": "组合 · 关联 · token", "tag": "保存切块初始版", "width": 156 },
    { "id": "chunk-review", "lane": "model", "col": 3, "type": "cloud", "label": "复核父子块", "sublabel": "条件 · 边界 · 关联", "tag": "记录模型意见", "width": 156 },
    { "id": "chunk-human", "lane": "human", "col": 3, "type": "security", "label": "裁决切块争议", "sublabel": "保留或调整结果", "tag": "未解决则待处理", "width": 156 },
    { "id": "output", "lane": "program", "col": 4, "type": "database", "label": "复检并输出结果", "sublabel": "原文 · 归属 · 长度", "tag": "结果与审核记录", "width": 154 },
    { "id": "retrieval", "lane": "program", "col": 5, "type": "backend", "label": "检索并回取证据", "sublabel": "子块 → 父块及关联", "tag": "后续 LangChain", "width": 160 }
  ],
  "edges": [
    { "id": "read-parse", "from": "source", "to": "parse", "role": "main" },
    { "id": "parse-structure-review", "from": "parse", "to": "structure-review", "role": "main" },
    { "id": "structure-pass", "from": "structure-review", "to": "structure-ready", "label": "通过", "role": "main" },
    { "id": "structure-conflict", "from": "structure-review", "to": "structure-human", "label": "冲突或无法判断", "role": "branch", "variant": "security" },
    { "id": "structure-resolved", "from": "structure-human", "to": "structure-ready", "label": "裁决后校验", "role": "return" },
    { "id": "structure-build", "from": "structure-ready", "to": "build", "role": "main" },
    { "id": "build-chunk-review", "from": "build", "to": "chunk-review", "role": "main" },
    { "id": "chunk-pass", "from": "chunk-review", "to": "output", "label": "通过", "role": "main" },
    { "id": "chunk-conflict", "from": "chunk-review", "to": "chunk-human", "label": "冲突或无法判断", "role": "branch", "variant": "security" },
    { "id": "chunk-resolved", "from": "chunk-human", "to": "output", "label": "裁决后校验", "role": "return" },
    { "id": "output-retrieval", "from": "output", "to": "retrieval", "label": "后续接入", "role": "main", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "cyan", "title": "原文保全贯穿处理", "items": ["原文保持不变，片段按原位置截取。", "基础单元逐字拼回全文，来源与版本可追溯。"] },
    { "dot": "amber", "title": "复核和裁决的边界", "items": ["模型只提意见；冲突及无法判断项交人工。", "调用失败或争议未解决，保留待处理状态。"] },
    { "dot": "violet", "title": "上游变更与当前状态", "items": ["发现结构错误，回查结构并重建受影响切块。", "本图表示设计流程，切块与模型复核尚未执行。"] }
  ]
}
