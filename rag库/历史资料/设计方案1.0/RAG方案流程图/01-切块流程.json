{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "切块方案 · 处理流程",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "structure",
      "label": "结构识别与确认"
    },
    {
      "id": "chunk",
      "label": "父子块生成与复核"
    },
    {
      "id": "decision",
      "label": "人工裁决与正式输出"
    }
  ],
  "nodes": [
    {
      "id": "source_read",
      "lane": "structure",
      "col": 0,
      "type": "backend",
      "label": "读取原文",
      "sublabel": "元数据、哈希、位置",
      "width": 152,
      "height": 64
    },
    {
      "id": "parse_structure",
      "lane": "structure",
      "col": 1,
      "type": "backend",
      "label": "程序识别结构",
      "sublabel": "章节、条款、段落",
      "width": 152,
      "height": 64
    },
    {
      "id": "audit_structure",
      "lane": "structure",
      "col": 2,
      "type": "external",
      "label": "结构全量复核",
      "sublabel": "大模型逐对象审核",
      "width": 152,
      "height": 64
    },
    {
      "id": "freeze_structure",
      "lane": "structure",
      "col": 3,
      "type": "security",
      "label": "校验并固定结构",
      "sublabel": "覆盖、层级、原文映射",
      "width": 152,
      "height": 64
    },
    {
      "id": "split_parent_child",
      "lane": "chunk",
      "col": 3,
      "type": "backend",
      "label": "程序划分父子块",
      "sublabel": "条件完整、跨条依赖",
      "width": 152,
      "height": 64
    },
    {
      "id": "audit_chunks",
      "lane": "chunk",
      "col": 4,
      "type": "external",
      "label": "切块全量复核",
      "sublabel": "父块、子块及关联",
      "width": 152,
      "height": 64
    },
    {
      "id": "check_chunks",
      "lane": "chunk",
      "col": 5,
      "type": "security",
      "label": "定位与长度校验",
      "sublabel": "真实 token、来源一致",
      "width": 152,
      "height": 64
    },
    {
      "id": "publish_chunks",
      "lane": "decision",
      "col": 5,
      "type": "database",
      "label": "正式切块结果",
      "sublabel": "保留版本及待处理项",
      "width": 152,
      "height": 64
    },
    {
      "id": "resolve_structure",
      "lane": "chunk",
      "col": 2,
      "type": "security",
      "label": "结构争议裁决",
      "sublabel": "人工结论；未决待处理",
      "width": 152,
      "height": 64
    },
    {
      "id": "resolve_chunks",
      "lane": "decision",
      "col": 4,
      "type": "security",
      "label": "切块争议裁决",
      "sublabel": "人工结论；未决待处理",
      "width": 152,
      "height": 64
    }
  ],
  "edges": [
    {
      "from": "source_read",
      "to": "parse_structure"
    },
    {
      "from": "parse_structure",
      "to": "audit_structure"
    },
    {
      "from": "audit_structure",
      "to": "freeze_structure",
      "label": "通过"
    },
    {
      "from": "audit_structure",
      "to": "resolve_structure",
      "label": "冲突或不确定",
      "role": "branch"
    },
    {
      "from": "resolve_structure",
      "to": "freeze_structure",
      "label": "已裁决后校验",
      "role": "branch",
      "toSide": "bottom",
      "bias": 0.7
    },
    {
      "from": "freeze_structure",
      "to": "split_parent_child"
    },
    {
      "from": "split_parent_child",
      "to": "audit_chunks"
    },
    {
      "from": "audit_chunks",
      "to": "check_chunks",
      "label": "通过"
    },
    {
      "from": "audit_chunks",
      "to": "resolve_chunks",
      "label": "冲突或不确定",
      "role": "branch"
    },
    {
      "from": "resolve_chunks",
      "to": "check_chunks",
      "label": "已裁决后校验",
      "role": "branch"
    },
    {
      "from": "check_chunks",
      "to": "publish_chunks"
    }
  ],
  "mainPath": [
    "source_read",
    "parse_structure",
    "audit_structure",
    "freeze_structure",
    "split_parent_child",
    "audit_chunks",
    "check_chunks",
    "publish_chunks"
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "复用开源方案",
      "items": [
        "markdown-it-py：Markdown 结构解析",
        "模型官方 processor/tokenizer：真实输入计数",
        "LangChain MultiVectorRetriever：后续父块回取适配"
      ]
    },
    {
      "dot": "violet",
      "title": "项目自行设计",
      "items": [
        "中文编号与层级栈、父子块边界及跨条依赖",
        "结构和切块两阶段复核、人工争议处理",
        "原文范围映射、覆盖校验及版本管理"
      ]
    },
    {
      "dot": "amber",
      "title": "选型边界",
      "items": [
        "全量复核模型与版本尚待固定",
        "LangChain 复用回取机制，不决定政策切块边界",
        "两阶段争议均须解决，未决范围保留待处理"
      ]
    }
  ]
}
