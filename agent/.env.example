# 模型连接；地址和密钥只在本地配置
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
STRUCTURED_OUTPUT=off
LLM_TEMPERATURE=
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2

# 运行限制
MAX_INPUT_CHARS=4000
MAX_USER_ID_CHARS=64
MAX_TURNS=8
RUN_TIMEOUT=180
TOOL_TIMEOUT=20
TOP_K_DEFAULT=8
TOP_K_MAX=20
SEARCH_SNIPPET_CHARS=300
READ_MAX_CHARS=6000

# 检索与存储
KB_BACKEND=mock
MOCK_KB_PATH=mock_data/kb.json
SESSION_PATH=data/sessions.sqlite
RUN_LOG=data/runs.jsonl
LOG_CONTENT=off
